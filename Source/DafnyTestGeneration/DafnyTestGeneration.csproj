<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>DafnyTestGeneration</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\..\Binaries\</OutputPath>
    <IsPackable>true</IsPackable>
    <DefineConstants>TRACE</DefineConstants>
      <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\DafnyPipeline\DafnyPipeline.csproj" />
  </ItemGroup>

  <!-- The library text is shipped, not compiled: the C# files target the generated contract program and are
       type-checked by DafnyTestGeneration.Test instead. -->
  <ItemGroup>
    <Compile Remove="ContractTesting/Library/**" />
    <EmbeddedResource Include="ContractTesting/Library/*" LogicalName="DafnyTestGeneration.ContractTesting.Library.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
